<Project>
    <PropertyGroup>
        <SmapiManifestSdkRoot>$(MSBuildThisFileDirectory)..\</SmapiManifestSdkRoot>
        <ManifestTaskAssembly Condition="'$(ManifestTaskAssembly)' == ''">$(SmapiManifestSdkRoot)tools\ManifestTask.dll</ManifestTaskAssembly>
    </PropertyGroup>

    <UsingTask
            TaskName="ManifestTask.GenerateManifest"
            AssemblyFile="$(ManifestTaskAssembly)"
            Condition="Exists('$(ManifestTaskAssembly)')" />
</Project>