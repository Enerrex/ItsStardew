<Project>
    <PropertyGroup>
        <!-- opt-in / feature flags -->
        <GenerateManagedManifest Condition="'$(GenerateManagedManifest)' == ''">false</GenerateManagedManifest>
        <ContentManager Condition="'$(ContentManager)' == ''">false</ContentManager>

        <!-- stable roots -->
        <ManifestSdkRoot Condition="'$(ManifestSdkRoot)' == ''">$(MSBuildThisFileDirectory)</ManifestSdkRoot>
        <ManifestImportsRoot Condition="'$(ManifestImportsRoot)' == ''">$(ManifestSdkRoot)imports\</ManifestImportsRoot>

        <!-- stable static defaults -->
        <ManifestAuthor Condition="'$(ManifestAuthor)' == ''">$(ManifestVar_Author)</ManifestAuthor>

        <!-- optional behavior switches -->
        <ManifestEmitDebugMessages Condition="'$(ManifestEmitDebugMessages)' == ''">false</ManifestEmitDebugMessages>
    </PropertyGroup>
</Project>