<Project>
    <PropertyGroup>
        <ManifestSdkRoot>$(MSBuildThisFileDirectory)..\</ManifestSdkRoot>
        <ManifestTaskAssembly Condition="'$(ManifestTaskAssembly)' == ''">$(ManifestSdkRoot)tools\ManifestTask.dll</ManifestTaskAssembly>
    </PropertyGroup>

    <UsingTask
            TaskName="ManifestTask.GenerateManifest"
            AssemblyFile="$(ManifestTaskAssembly)"
            Condition="Exists('$(ManifestTaskAssembly)')" />
</Project>