<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>

        <Version>1.0.0</Version>
        <Description>Central manager for metals-related shared assets and APIs.</Description>

        <EnableManifestGeneration>true</EnableManifestGeneration>
        <ModUniqueId>$(UniqueId_MetalsContentManager)</ModUniqueId>

        <!-- Optional. Leave unset unless you need to override the assembly file name. -->
        <!-- <AssemblyName>MetalsContentManager</AssemblyName> -->
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" />
        <ProjectReference Include="..\..\Common\UniqueIds\UniqueIds.csproj" />
        <ProjectReference Include="..\..\Common\StringUtils\StringUtils.csproj" />
    </ItemGroup>
</Project>
