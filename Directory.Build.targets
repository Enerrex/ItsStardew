<Project>
    <UsingTask
            TaskName="BuildTasks.WriteManifestFromTemplate"
            AssemblyFile="$(MSBuildThisFileDirectory)Tools\BuildTasks\bin\$(Configuration)\net10.0\BuildTasks.dll" />

    <PropertyGroup>
        <EnableManifestGeneration Condition="'$(EnableManifestGeneration)' == ''">false</EnableManifestGeneration>
        <ManifestTemplateFile Condition="'$(ManifestTemplateFile)' == ''">$(MSBuildProjectDirectory)\manifest.template.json</ManifestTemplateFile>
        <ManifestOutputFile Condition="'$(ManifestOutputFile)' == ''">$(MSBuildProjectDirectory)\manifest.json</ManifestOutputFile>
        <ManifestWriteOnlyWhenDifferent Condition="'$(ManifestWriteOnlyWhenDifferent)' == ''">true</ManifestWriteOnlyWhenDifferent>
    </PropertyGroup>

    <Target Name="GenerateManifest"
            BeforeTargets="BeforeBuild"
            Condition="'$(EnableManifestGeneration)' == 'true' and Exists('$(ManifestTemplateFile)')">

        <PropertyGroup>
            <EffectiveEntryDll Condition="'$(EntryDll)' != ''">$(EntryDll)</EffectiveEntryDll>
            <EffectiveEntryDll Condition="'$(EffectiveEntryDll)' == '' and '$(AssemblyName)' != ''">$(AssemblyName)$(TargetExt)</EffectiveEntryDll>
            <EffectiveEntryDll Condition="'$(EffectiveEntryDll)' == ''">$(MSBuildProjectName)$(TargetExt)</EffectiveEntryDll>
        </PropertyGroup>

        <Error Condition="'$(ModUniqueId)' == ''"
               Text="Manifest generation failed for $(MSBuildProjectName): ModUniqueId is empty." />

        <ItemGroup>
            <ManifestReplacement Include="Author">
                <Token>__Author__</Token>
                <Value>$(Author)</Value>
            </ManifestReplacement>

            <ManifestReplacement Include="Version">
                <Token>__Version__</Token>
                <Value>$(Version)</Value>
            </ManifestReplacement>

            <ManifestReplacement Include="Description">
                <Token>__Description__</Token>
                <Value>$(Description)</Value>
            </ManifestReplacement>

            <ManifestReplacement Include="ModUniqueId">
                <Token>__ModUniqueId__</Token>
                <Value>$(ModUniqueId)</Value>
            </ManifestReplacement>

            <ManifestReplacement Include="EntryDll">
                <Token>__EntryDll__</Token>
                <Value>$(EffectiveEntryDll)</Value>
            </ManifestReplacement>

            <ManifestReplacement Include="MinimumApiVersion">
                <Token>__MinimumApiVersion__</Token>
                <Value>$(MinimumApiVersion)</Value>
            </ManifestReplacement>

            <ManifestReplacement Include="UpdateKeys">
                <Token>__UpdateKeys__</Token>
                <Value>$(UpdateKeys)</Value>
            </ManifestReplacement>

            <ManifestReplacement Include="MetalsContentManagerUniqueId"
                                 Condition="'$(MetalsContentManagerUniqueId)' != ''">
                <Token>__MetalsContentManagerUniqueId__</Token>
                <Value>$(MetalsContentManagerUniqueId)</Value>
            </ManifestReplacement>

            <ManifestReplacement Include="ContentPackForUniqueId"
                                 Condition="'$(ContentPackForUniqueId)' != ''">
                <Token>__ContentPackForUniqueId__</Token>
                <Value>$(ContentPackForUniqueId)</Value>
            </ManifestReplacement>
        </ItemGroup>

        <BuildTasks.WriteManifestFromTemplate
                TemplateFile="$(ManifestTemplateFile)"
                OutputFile="$(ManifestOutputFile)"
                Replacements="@(ManifestReplacement)"
                WriteOnlyWhenDifferent="$(ManifestWriteOnlyWhenDifferent)" />
    </Target>
</Project>