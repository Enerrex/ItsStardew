<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Version>1.0.0</Version>
        <Description>Content pack providing casting machine assets.</Description>

        <GenerateManagedManifest>true</GenerateManagedManifest>
        <ManifestKind>SmapiContentPack</ManifestKind>

        <ManifestName>Its Stardew Casting Machine Assets</ManifestName>
        <ManifestUniqueId>$(PROJECTVARS_CONTENT_PACKS_METALS_CASTINGMACHINE)</ManifestUniqueId>
        <ManifestAuthor>$(PROJECTVARS_AUTHOR_NAME)</ManifestAuthor>
        <ManifestContentParkFor>$(PROJECTVARS_CONTENT_MANAGERS_METALS)</ManifestContentParkFor>

        <ManagedManifestOutputPath>$(MSBuildProjectDirectory)\manifest.json</ManagedManifestOutputPath>
    </PropertyGroup>
</Project>