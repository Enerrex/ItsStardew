<Project>
    <Import Project="build/Generated.ModIds.props"
            Condition="Exists('build/Generated.ModIds.props')" />
    
    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <ModFamilyPrefix>[ItsStardew]</ModFamilyPrefix>

        <EnableManifestGeneration>false</EnableManifestGeneration>
        <ManifestTemplateFile>$(MSBuildProjectDirectory)\manifest.template.json</ManifestTemplateFile>
        <ManifestOutputFile>$(MSBuildProjectDirectory)\manifest.json</ManifestOutputFile>
    </PropertyGroup>
    
</Project>