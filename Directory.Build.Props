<Project>
    <Import Project="build/sdk/SmapiManifestSdk/GenerateSmapiManifest.props"
            Condition="Exists('build/sdk/SmapiManifestSdk/GenerateSmapiManifest.props')" />
    
    <Import Project="build/generated/ManifestVariables.g.props"
            Condition="Exists('build/generated/ManifestVariables.g.props')" />
    
    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>
</Project>